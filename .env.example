# Salin ke .env lalu sesuaikan. File .env tidak ikut di-commit.

# --- PostgreSQL ---
POSTGRES_USER=kilat
POSTGRES_PASSWORD=kilat
POSTGRES_DB=kilat
POSTGRES_PORT=5432
# Dipakai saat menjalankan service langsung dengan `go run` (di luar Docker)
DATABASE_URL=postgres://kilat:kilat@localhost:5432/kilat?sslmode=disable

# --- Redis ---
REDIS_PORT=6379
REDIS_ADDR=localhost:6379

# --- Product Service ---
PRODUCT_PORT=8081
PRODUCT_HTTP_ADDR=:8081
